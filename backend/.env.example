# HomeGuard AI Backend Environment Variables

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo credentials
DEMO_EMAIL=demo@homeguard.ai
DEMO_PASSWORD=demo123

# JWT Secret (change in production!)
JWT_SECRET=homeguard-ai-demo-secret-key-change-in-production

# Supabase (optional — remove to use local SQLite)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API (optional — OCR falls back to manual entry without it)
# GEMINI_API_KEY=your-gemini-api-key

# Electricity rate in INR per kWh
ELECTRICITY_RATE=8.0
